# =============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env de verdade no Git.
# =============================================================

# --- 3C Plus (API REST v1) ---
# Token gerado no painel do 3C Plus.
# Base URL real (confirmada via SDK oficial fluxoti/3cplusv2-sdk-js):
#   https://app.3c.fluxoti.com  (com prefixo /v1 nas rotas)
TRES_C_PLUS_TOKEN=cole_seu_token_aqui
TRES_C_PLUS_BASE_URL=https://app.3c.fluxoti.com

# --- Exact Sales (Spotter) ---
# Token: no Spotter, vá em Configurações > Integrações > Token Exact API
EXACT_TOKEN=cole_seu_token_aqui
EXACT_BASE_URL=https://api.exactspotter.com/v3

# --- SGCor (login web via navegador) ---
# Use o subdomínio da sua corretora
SGCOR_URL=https://SEU-SUBDOMINIO.sgcor.com.br
SGCOR_USER=seu_usuario
SGCOR_PASSWORD=sua_senha
